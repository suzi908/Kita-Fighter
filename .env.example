# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# SUPABASE PROJECT CREDENTIALS (VITE CLIENT-SIDE)
# Dapatkan maklumat ini dari: Supabase Dashboard -> Project Settings -> API
# ==============================================================================
# Project URL (cth: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Project API Key - HANYA GUNAKAN 'anon' / 'public' Key.
# AMARAN KESELAMATAN: JANGAN SESEKALI MASUKKAN 'service_role' KEY DI SINI!
VITE_SUPABASE_ANON_KEY="your-anon-key"
